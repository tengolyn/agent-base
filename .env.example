# Copy to .env at the repo root and fill in. Never commit real values (.env is gitignored).
# Two sections: the app's own keys, then agentic development (build loop, agent tooling).

# ============================================================
# App: keys the product reads at runtime
# ============================================================
# <SERVICE>_API_KEY=
# <APP>_SETTING=

# ============================================================
# Agentic development: read by .agents/ tooling, not the app
# ============================================================
# Build loop defaults (.agents/scripts/build_loop.sh). Unset = built-in default; shell env and flags override.
# The loop reads only these keys from .env.
# BUILD_LOOP_MAX=40        # iterations at most
# BUILD_LOOP_STALL=3       # stop after N iterations in a row with no progress
# BUILD_LOOP_TIMEBOX=120   # minutes per iteration before it is killed
# BUILD_LOOP_MODEL=opus    # claude model for each session
# BUILD_LOOP_BUDGET=       # USD cap per iteration (claude --max-budget-usd); empty = none

# Auth: claude and gh use their own logins (`claude login`, `gh auth login`); nothing needed here.
# Set ANTHROPIC_API_KEY / GH_TOKEN in the shell only to override those logins (API key = pay-per-use billing).

# Not here on purpose: ALLOW_MAIN_PUSH=1 (one-off pre-push override, owner's explicit word only; never persist it).

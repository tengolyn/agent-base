# AgentBase: local files that agent work creates. Append these lines to the project's .gitignore.
# The setup itself (AGENTS.md, CLAUDE.md, .agents/, .claude/ skills and agents) stays tracked: do not ignore it.

# secrets: only the example is tracked
.env
.env.*
!.env.example

# task queue: task files are local only; the status folders (.gitkeep) are tracked
.agents/state/tasks/*/*
!.agents/state/tasks/*/.gitkeep

# build loop logs and stop file
.agents/state/build-loop/
.agents/state/BUILD_OFF

# Claude Code: personal settings and its worktrees
.claude/settings.local.json
.claude/worktrees/
